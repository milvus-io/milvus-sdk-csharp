<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- TLSExample constructs GrpcChannelOptions directly and the SDK depends on Google.Protobuf; reference
         both explicitly so the examples restore and bin always carry them (ProjectReference-transitive
         NuGet assets were not reliably flowed into the examples restore). -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <ProjectReference Include="..\..\Milvus.Client.V2\Milvus.Client.V2.csproj" />
  </ItemGroup>

</Project>
